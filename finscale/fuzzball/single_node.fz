version: v1

volumes:
  shared:
    use: ephemeral   # TODO(fuzzball): confirm jobs in one workflow can share this volume

jobs:
  train:
    image:
      uri: docker://<REGISTRY>/finscale:<TAG>   # TODO: set after organizers confirm how team images are published
    resource:
      cpu:
        cores: 16
      memory:
        size: 64GiB
      devices:
        nvidia.com/gpu: 1
    mounts:
      shared:
        location: /shared
    script: |
      #!/bin/bash
      set -e
      cd /app
      python gen_data.py
      torchrun --standalone --nproc_per_node=1 train_gb10.py --out /shared/out/adapter
      python merge_adapter.py Qwen/Qwen2.5-0.5B-Instruct /shared/out/adapter /shared/merged

  serve:
    # TODO(fuzzball): add dependency on train (key unconfirmed: requires / depends_on)
    # TODO(fuzzball): confirm how a long-running job exposes port 8000
    image:
      uri: docker://<REGISTRY>/finscale-serve:<TAG>   # vLLM or llama.cpp arm64 image; confirm availability
    resource:
      cpu:
        cores: 8
      memory:
        size: 32GiB
      devices:
        nvidia.com/gpu: 1
    mounts:
      shared:
        location: /shared
    script: |
      #!/bin/bash
      python -m vllm.entrypoints.openai.api_server --model /shared/merged \
        --served-model-name finscale --port 8000

  eval:
    # TODO(fuzzball): depends on serve; confirm service hostname for the endpoint
    image:
      uri: docker://<REGISTRY>/finscale:<TAG>
    resource:
      cpu:
        cores: 2
      memory:
        size: 4GiB
    script: |
      #!/bin/bash
      cd /app
      python evaluate_endpoint.py http://<SERVE_HOST>:8000/v1 finscale
